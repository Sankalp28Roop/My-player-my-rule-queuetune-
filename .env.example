# StrictQueue (QueueTune v2.4 Studio)
# -------------------------------------------------------------
# Optional Environment Configuration
# Copy this file to .env for local overrides.
# NOTE: Personal API keys are strictly optional! The app runs
# completely zero-key out-of-the-box using the built-in search proxy.

# Port for local Python server (Default: 8080)
PORT=8080

# Optional YouTube Data API v3 Key (Fallback works without key)
# YOUTUBE_API_KEY=

# Optional Google Gemini API Key for AI Track Advisor
# GEMINI_API_KEY=
